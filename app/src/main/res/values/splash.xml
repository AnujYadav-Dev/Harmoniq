<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- neutral fallback, used until a theme-matched splash is registered (Android 13+) -->
    <style name="Theme.Harmoniq.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Harmoniq</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- one per PrimaryThemeColor, registered at runtime via SplashTheme -->
    <style name="Theme.Harmoniq.SplashScreen.Red">
        <item name="windowSplashScreenBackground">@color/theme_red</item>
    </style>
    <style name="Theme.Harmoniq.SplashScreen.Orange">
        <item name="windowSplashScreenBackground">@color/theme_orange</item>
    </style>
