<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- neutral fallback, the only splash before Android 12, where no theme can be registered -->
    <style name="Theme.Harmoniq.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="splashLogoInk">@color/splash_logo_ink</item>
        <item name="splashLogoAccent">@color/splash_logo_accent</item>
        <item name="postSplashScreenTheme">@style/Theme.Harmoniq</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- one per PrimaryThemeColor, registered at runtime via SplashTheme. The system stores
         the registered name, so renaming one breaks the splash of existing installs -->
    <style name="Theme.Harmoniq.SplashScreen.Red">
        <item name="windowSplashScreenBackground">@color/theme_red</item>
        <item name="splashLogoInk">@color/splash_logo_ink_red</item>
        <item name="splashLogoAccent">@color/splash_logo_red</item>
    </style>
